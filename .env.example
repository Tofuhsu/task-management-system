# Copy to .env (git-ignored) for `docker compose up`. Generate fresh values, for example:
#   echo "MSSQL_SA_PASSWORD=Local-$(openssl rand -hex 12)" >> .env
#   echo "JWT_SIGNING_KEY=$(openssl rand -base64 48)" >> .env
MSSQL_SA_PASSWORD=
JWT_SIGNING_KEY=
# Login/register requests allowed per client IP per minute (default 10).
# The load test raises this because every virtual user shares one IP.
AUTH_RATE_LIMIT=10
# Host port for the API (default 8080).
API_PORT=8080
